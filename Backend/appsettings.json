{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=docboo;Username=docboo;Password=docboo"
  },
  "Api": {
    "EnableDocsUi": false
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "LocalUser": {
    "UserId": "00000000-0000-0000-0000-000000000001"
  },
  "DocumentLimits": {
    "MaxDocumentBytes": 2097152
  },
  "Storage": {
    "Root": "data/exports"
  },
  "Export": {
    "MaxConcurrency": 2,
    "QueueCapacity": 100,
    "RetentionHours": 24,
    "CleanupIntervalMinutes": 30,
    "MaxAttempts": 3
  },
  "LibreOffice": {
    "SofficePath": "",
    "TimeoutSeconds": 120
  }
}
