{
  "openapi": "3.1.1",
  "info": {
    "title": "Docboo API",
    "description": "Formatador de trabalhos acadêmicos (ABNT).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Runs all registered health checks and returns their status.",
        "operationId": "GetHealth",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/profiles": {
      "get": {
        "tags": [
          "Profiles"
        ],
        "summary": "Lists the available norm profiles.",
        "operationId": "ListProfiles",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ProfileResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/works": {
      "get": {
        "tags": [
          "Works"
        ],
        "summary": "Lists the user's works, most recently edited first.",
        "operationId": "ListWorks",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkSummaryResponse"
                  }
                }
              },
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkSummaryResponse"
                  }
                }
              },
              "text/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/WorkSummaryResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Works"
        ],
        "summary": "Creates a work with an empty document for the chosen norm profile.",
        "operationId": "CreateWork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/WorkResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/works/{id}": {
      "get": {
        "tags": [
          "Works"
        ],
        "summary": "Gets a work including its document.",
        "operationId": "GetWork",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/WorkResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Works"
        ],
        "summary": "Deletes a work.",
        "operationId": "DeleteWork",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/works/{id}/document": {
      "put": {
        "tags": [
          "Works"
        ],
        "summary": "Replaces the document (autosave). The document is sanitized and validated; send the\r\n`version` you loaded. A stale version returns 409 with `currentVersion`.",
        "operationId": "SaveWorkDocument",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDocumentRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SaveDocumentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SaveDocumentResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveDocumentResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaveDocumentResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "413": {
            "description": "Payload Too Large",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AbstractElement": {
        "required": [
          "enabled",
          "text",
          "keywords"
        ],
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "text": {
            "type": "string",
            "description": "Plain text. Paragraph breaks are `\\n`."
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      },
      "Attachment": {
        "required": [
          "id",
          "title",
          "blocks"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Block"
            }
          }
        },
        "additionalProperties": false,
        "description": "Appendix (written by the author) or annex (third-party material)."
      },
      "Block": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/BlockParagraphBlock"
          },
          {
            "$ref": "#/components/schemas/BlockLongQuoteBlock"
          },
          {
            "$ref": "#/components/schemas/BlockListBlock"
          },
          {
            "$ref": "#/components/schemas/BlockFigureBlock"
          },
          {
            "$ref": "#/components/schemas/BlockTableBlock"
          }
        ],
        "description": "Block-level content inside a section, appendix or annex. Discriminated by `type`.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "paragraph": "#/components/schemas/BlockParagraphBlock",
            "longQuote": "#/components/schemas/BlockLongQuoteBlock",
            "list": "#/components/schemas/BlockListBlock",
            "figure": "#/components/schemas/BlockFigureBlock",
            "table": "#/components/schemas/BlockTableBlock"
          }
        }
      },
      "BlockFigureBlock": {
        "required": [
          "assetId",
          "caption",
          "source",
          "widthPercent",
          "id",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "figure"
            ],
            "type": "string"
          },
          "assetId": {
            "type": "string",
            "description": "Uploaded image id."
          },
          "caption": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inline"
            }
          },
          "source": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inline"
            },
            "description": "Source line (\"Fonte: ...\"), without the \"Fonte:\" prefix."
          },
          "widthPercent": {
            "type": "integer",
            "description": "Width relative to the text area, 10..100.",
            "format": "int32"
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BlockListBlock": {
        "required": [
          "ordered",
          "items",
          "id",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "list"
            ],
            "type": "string"
          },
          "ordered": {
            "type": "boolean"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ListItem"
            }
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BlockLongQuoteBlock": {
        "required": [
          "content",
          "id",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "longQuote"
            ],
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inline"
            },
            "description": "Quoted text, usually ending with a citation inline."
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "description": "Direct quotation longer than three lines. Formatting (indent, size, spacing) comes from the profile."
      },
      "BlockParagraphBlock": {
        "required": [
          "content",
          "id",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "paragraph"
            ],
            "type": "string"
          },
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inline"
            }
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "BlockTableBlock": {
        "required": [
          "title",
          "source",
          "rows",
          "id",
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "table"
            ],
            "type": "string"
          },
          "title": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inline"
            }
          },
          "source": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inline"
            },
            "description": "Source line (\"Fonte: ...\"), without the \"Fonte:\" prefix."
          },
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TableRow"
            }
          },
          "id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CitationMode": {
        "enum": [
          "parenthetical",
          "narrative"
        ]
      },
      "CreateWorkRequest": {
        "required": [
          "profileId"
        ],
        "type": "object",
        "properties": {
          "profileId": {
            "maxLength": 64,
            "minLength": 1,
            "type": "string",
            "description": "Norm profile id (see `GET /api/profiles`)."
          },
          "title": {
            "maxLength": 500,
            "minLength": 0,
            "type": [
              "null",
              "string"
            ],
            "description": "Initial title. Defaults to \"Trabalho sem título\"."
          }
        },
        "additionalProperties": false,
        "description": "Creates a work with an empty document for the chosen norm profile."
      },
      "CslDate": {
        "type": "object",
        "properties": {
          "date-parts": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "array",
              "items": {
                "type": "integer",
                "format": "int32"
              }
            },
            "description": "[[year, month?, day?]] (a second entry denotes a range)."
          },
          "literal": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "CslItem": {
        "required": [
          "id",
          "type"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "CSL item type: book, article-journal, chapter, thesis, webpage, ..."
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "author": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CslName"
            }
          },
          "editor": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/CslName"
            }
          },
          "issued": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CslDate"
              }
            ]
          },
          "accessed": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CslDate"
              }
            ]
          },
          "container-title": {
            "type": [
              "null",
              "string"
            ]
          },
          "publisher": {
            "type": [
              "null",
              "string"
            ]
          },
          "publisher-place": {
            "type": [
              "null",
              "string"
            ]
          },
          "edition": {
            "type": [
              "null",
              "string"
            ]
          },
          "volume": {
            "type": [
              "null",
              "string"
            ]
          },
          "issue": {
            "type": [
              "null",
              "string"
            ]
          },
          "page": {
            "type": [
              "null",
              "string"
            ]
          },
          "genre": {
            "type": [
              "null",
              "string"
            ]
          },
          "number": {
            "type": [
              "null",
              "string"
            ]
          },
          "URL": {
            "type": [
              "null",
              "string"
            ]
          },
          "DOI": {
            "type": [
              "null",
              "string"
            ]
          },
          "ISBN": {
            "type": [
              "null",
              "string"
            ]
          },
          "ISSN": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false,
        "description": "Bibliographic item in CSL-JSON format (https://citeproc-js.readthedocs.io/en/latest/csl-json/markup.html).\r\nThe common fields are typed; any other CSL field is preserved in Dictionary&lt;string, JsonElement&gt;? CslItem.Extra."
      },
      "CslName": {
        "type": "object",
        "properties": {
          "family": {
            "type": [
              "null",
              "string"
            ]
          },
          "given": {
            "type": [
              "null",
              "string"
            ]
          },
          "literal": {
            "type": [
              "null",
              "string"
            ],
            "description": "Institutional author or a name that must not be split."
          }
        },
        "additionalProperties": false
      },
      "DocumentMetadata": {
        "required": [
          "institution",
          "faculty",
          "course",
          "authors",
          "title",
          "subtitle",
          "advisor",
          "coAdvisor",
          "city",
          "year",
          "nature"
        ],
        "type": "object",
        "properties": {
          "institution": {
            "type": "string"
          },
          "faculty": {
            "type": [
              "null",
              "string"
            ]
          },
          "course": {
            "type": "string"
          },
          "authors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": "string"
          },
          "subtitle": {
            "type": [
              "null",
              "string"
            ]
          },
          "advisor": {
            "type": "string"
          },
          "coAdvisor": {
            "type": [
              "null",
              "string"
            ]
          },
          "city": {
            "type": "string",
            "description": "City of the institution (local)."
          },
          "year": {
            "type": [
              "null",
              "integer"
            ],
            "description": "Year of deposit/presentation.",
            "format": "int32"
          },
          "nature": {
            "type": "string",
            "description": "Nature of the work (\"Trabalho de Conclusão de Curso apresentado ...\")."
          }
        },
        "additionalProperties": false
      },
      "DocumentModel": {
        "required": [
          "schemaVersion",
          "profileId",
          "profileOverrides",
          "metadata",
          "preTextual",
          "textual",
          "postTextual",
          "references"
        ],
        "type": "object",
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "description": "Version of this JSON schema. Currently always 1.",
            "format": "int32"
          },
          "profileId": {
            "type": "string",
            "description": "Norm profile used to format the work (e.g. `abnt-tcc`)."
          },
          "profileOverrides": {
            "description": "Per-work overrides of profile options that the profile allows to change.",
            "$ref": "#/components/schemas/ProfileOverrides"
          },
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "preTextual": {
            "$ref": "#/components/schemas/PreTextual"
          },
          "textual": {
            "$ref": "#/components/schemas/Textual"
          },
          "postTextual": {
            "$ref": "#/components/schemas/PostTextual"
          },
          "references": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CslItem"
            },
            "description": "Bibliographic references (CSL-JSON compatible). Citations point to string CslItem.Id."
          }
        },
        "additionalProperties": false,
        "description": "Source of truth for an academic work (schema v1). Edited by the frontend, stored as JSONB,\r\nand consumed by the Exporter. Breaking changes require a new int DocumentModel.SchemaVersion\r\nand a migration step (see docs/document-model.md)."
      },
      "FontFamilyOption": {
        "enum": [
          "timesNewRoman",
          "arial",
          null
        ]
      },
      "GeneratedLists": {
        "required": [
          "figures",
          "tables"
        ],
        "type": "object",
        "properties": {
          "figures": {
            "type": "boolean"
          },
          "tables": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "HealthCheckEntry": {
        "required": [
          "name",
          "status",
          "durationMs"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Check name."
          },
          "status": {
            "type": "string",
            "description": "Check status."
          },
          "durationMs": {
            "type": "number",
            "description": "How long the check took, in milliseconds.",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "HealthResponse": {
        "required": [
          "status",
          "version",
          "checks"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Overall status: `Healthy`, `Degraded` or `Unhealthy`."
          },
          "version": {
            "type": "string",
            "description": "API assembly version."
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HealthCheckEntry"
            },
            "description": "Individual dependency checks (database, etc.)."
          }
        },
        "additionalProperties": false,
        "description": "Liveness/readiness snapshot returned by `GET /api/health`."
      },
      "Inline": {
        "required": [
          "type"
        ],
        "type": "object",
        "anyOf": [
          {
            "$ref": "#/components/schemas/InlineTextInline"
          },
          {
            "$ref": "#/components/schemas/InlineHardBreakInline"
          },
          {
            "$ref": "#/components/schemas/InlineCitationInline"
          },
          {
            "$ref": "#/components/schemas/InlineFootnoteInline"
          }
        ],
        "description": "Inline content inside a block. Discriminated by `type`; mirrors the editor (Tiptap) node types.",
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "text": "#/components/schemas/InlineTextInline",
            "hardBreak": "#/components/schemas/InlineHardBreakInline",
