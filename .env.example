# Copy to .env and adjust. Every value has a default in docker-compose.yml.

# PostgreSQL (published on 127.0.0.1 so the API can also run natively)
POSTGRES_DB=docboo
POSTGRES_USER=docboo
POSTGRES_PASSWORD=change-me
DB_PORT=5432

# pgAdmin (http://localhost:5050, bound to 127.0.0.1, no login screen)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
PGADMIN_PORT=5050

# API
API_PORT=5248
ASPNETCORE_ENVIRONMENT=Production
# true exposes /swagger and /scalar
API_ENABLE_DOCS_UI=true
